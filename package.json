{
  "name": "canteen-os",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "CanteenOS — 团队用餐计划、备料与采购协作；中英乌三语，data/ 目录即知识库",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "node scripts/validate-schemas.mjs",
    "validate:local": "python3 scripts/local-validate.py",
    "issues:dry": "node scripts/create-issues.mjs --dry-run",
    "issues:sync": "node scripts/create-issues.mjs",
    "test:core": "npm --prefix packages/core test",
    "test:worker": "npm --prefix packages/worker test",
    "backlog:waves": "node scripts/backlog-waves.mjs",
    "translate": "node scripts/translate.mjs",
    "translate:dry": "node scripts/translate.mjs --dry-run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare:team-image-tools": "node scripts/prepare-team-image-tools.mjs",
    "check:team-image-tools": "node scripts/prepare-team-image-tools.mjs --check",
    "land": "node scripts/land.mjs",
    "land:dry": "node scripts/land.mjs --dry-run",
    "build:data": "node scripts/build-data.mjs",
    "build:check": "node scripts/build-data.mjs --check --compare-snapshots",
    "web:dev": "pnpm -C packages/web dev",
    "web:build": "pnpm -C packages/web build"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jpeg-js": "0.4.4",
    "pngjs": "5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "Apache-2.0"
}
