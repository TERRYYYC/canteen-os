{
  "name": "@canteenos/core",
  "version": "0.0.3",
  "private": true,
  "description": "CanteenOS core: types, procurement engine, three sheet renderers, readiness gates. Types mirror schemas/ (single source of truth).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:types": "node ../../scripts/check-types-vs-schema.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "generate:week41": "npm run build && node scripts/generate-week41.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0"
}
