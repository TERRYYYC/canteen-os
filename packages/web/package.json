{
  "name": "@canteenos/web",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "CanteenOS 团队用餐网页：菜单计划、备料、人工确认采购、菜品与食材编辑及发布；原生 DOM + TypeScript，读取同版静态资料，写入通过显式配置的 Worker。",
  "homepage": "https://terryyyc.github.io/canteen-os/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-icons.mjs && node scripts/gen-qr.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "qr": "node scripts/gen-qr.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@canteenos/core": "workspace:*"
  },
  "devDependencies": {
    "qrcode": "1.5.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  },
  "license": "Apache-2.0"
}
