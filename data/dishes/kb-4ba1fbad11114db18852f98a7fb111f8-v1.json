  "name": {
    "zh": "陈皮排骨"
  },
  "provenance": {
    "coverState": "needs-image",
    "recipeId": "4ba1fbad-1111-4db1-8852-f98a7fb111f8",
    "recipeVersion": 1,
    "snapshotHash": "e54d1fe48e5feeba7b1b93619d04f4cf49432d42014a6bcbb3cad3cffe1c188c",
    "source": "knowledge"
  },
  "schemaVersion": "3",
  "status": "active",
  "steps": [
    {
      "text": {
        "zh": "备排骨两斤并泡水，讲解说明新鲜排骨泡水后不焯水；陈皮三块提前泡水，另三块打碎，分开留用。备三个八角、一个桂皮、一些二荆条辣椒碎，以及多些蒜和小米辣。"
      }
    },
    {
      "text": {
        "zh": "用油煸排骨，过程中加入八角和桂皮；煸得较干时补一些料酒，或用米酒替代。"
      }
    },
    {
      "text": {
        "zh": "排骨略带焦边时调小火，加入一勺辣妹子辣椒酱和一勺香辣酱，小火把酱炒香。"
      }
    },
    {
      "text": {
        "zh": "转入炖锅，加入提前泡好的陈皮水和辣椒料（此处讲解称“辣椒面”）；画面中陈皮片也在锅内。再加水至没过食材。"
      }
    },
    {
      "text": {
        "zh": "盖上锅盖，小火炖一个小时15分钟。"
      }
    },
    {
      "text": {
        "zh": "到时间后挑出八角、桂皮等香料，再加蒜和小米辣，大火收汁15分钟。"
      }
    },
    {
      "text": {
        "zh": "出锅前汤汁基本收到黏稠时，撒上提前打碎的另一份陈皮。"
      }
    },
    {
      "text": {
        "zh": "出锅后搅拌，让陈皮碎更均匀地粘在排骨上。"
      }
    }
  ]
}
