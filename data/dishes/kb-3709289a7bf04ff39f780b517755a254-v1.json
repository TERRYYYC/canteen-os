    "source": "knowledge"
  },
  "schemaVersion": "3",
  "status": "active",
  "steps": [
    {
      "text": {
        "zh": "选择牛里脊（可用牛吊龙替代），准备画面所示牛肉片；视频没有演示切片。"
      }
    },
    {
      "text": {
        "zh": "牛肉加入白胡椒粉、蚝油和龙牌酱油拌匀。"
      }
    },
    {
      "text": {
        "zh": "拍碎一块生姜，在水中抓出姜汁；将姜水倒入牛肉并抓打，至肉能粘住手。"
      }
    },
    {
      "text": {
        "zh": "红薯淀粉加一点水调浆，少量分次加入牛肉，抓至表面只有薄薄一层浆，最后淋点食用油。"
      }
    },
    {
      "text": {
        "zh": "空锅放入青红辣椒，按压煸烧，加点盐；至表皮起泡焦斑的画面状态后取出剁碎。"
      }
    },
    {
      "text": {
        "zh": "锅中下猪油，倒入剁碎的烧椒炒动，再加半碗水。"
      }
    },
    {
      "text": {
        "zh": "汤汁加一点盐、白糖、味精、酱油，再加生抽调味。"
      }
    },
    {
      "text": {
        "zh": "汤汁煮开后转小火，把上浆牛肉下入；下锅先不要动，等牛肉定型后再轻推。"
      }
    },
    {
      "text": {
        "zh": "勾一点芡，让汤汁更浓。"
      }
    },
    {
      "text": {
        "zh": "将熟烧椒牛肉连汤浇在盘中白色豆花块上，完成装盘。"
      }
    }
  ]
}
