  "status": "active",
  "steps": [
    {
      "text": {
        "zh": "鱿鱼180克先切成小粒，再用刀剁到发黏。"
      }
    },
    {
      "text": {
        "zh": "大葱10克、生姜5克放入碗中，加入清水50克，用手抓揉成浑浊的葱姜水，先放一边泡着。"
      }
    },
    {
      "text": {
        "zh": "鸡胸肉200克放入料理机打成鸡肉泥。"
      }
    },
    {
      "text": {
        "zh": "鸡肉泥中加入盐5克、味精2克、白胡椒粉1.5克，先把调料搅匀。"
      }
    },
    {
      "text": {
        "zh": "向鸡肉泥打入葱姜水并搅打，打好水后呈原片所示湿润黏稠状态。"
      }
    },
    {
      "text": {
        "zh": "加入前面剁好的鱿鱼，再加皮冻碎100克、蒜薹碎20克、花雕酒5克和芝麻香油15克。"
      }
    },
    {
      "text": {
        "zh": "充分搅匀，得到游龙戏凤饺子生馅。"
      }
    }
  ]
}
