{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/menu-plan-v3.schema.json",
  "title": "MenuPlanV3",
  "description": "小团队菜单：份数可省略；空 meals 表示取消全部安排。旧 v2 保持严格，见 ADR-0008。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3"
    },
    "name": {
      "$ref": "menu-plan.schema.json#/properties/name"
    },
    "dateRange": {
      "$ref": "menu-plan.schema.json#/properties/dateRange"
    },
    "margin": {
      "$ref": "menu-plan.schema.json#/properties/margin"
    },
    "meals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "mealType": {
            "$ref": "common.schema.json#/$defs/MealType"
          },
          "dishRef": {
            "$ref": "common.schema.json#/$defs/Id",
            "description": "data/dishes/ 下的菜品 id（文件名）"
          },
          "plannedServings": {
            "type": "integer",
            "minimum": 1
          },
          "serviceWindow": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}-\\d{2}:\\d{2}$",
            "description": "供餐时段（可选），HH:MM-HH:MM，如 12:00-14:00；菜单页餐次 chip 展示"
          }
        },
        "required": [
          "date",
          "mealType",
          "dishRef"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "meals"
  ],
  "additionalProperties": false
}
