{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/dish.schema.json",
  "title": "Dish",
  "description": "菜品（v2 收窄模型，ADR-0006）。一菜一文件：data/dishes/<id>.json，文件名即 ID。**允许不完整：除 name 外全部可选**——一道菜只有名字也能导入；缺什么由 readiness 关卡分级（能教/能排/能采，见 docs/modules/knowledge-base.md），不拒绝。status 默认视为 draft；git PR 即人工确认队列（无独立 review 状态）。components 必须 ingredientRef 引用 data/ingredients/ 下的食材（采购引擎 BOM 展开的前提）；prep.techniqueRef 与 steps[].techniqueRef 只能引用 data/techniques.json 闭集词表。",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "2" },
    "name": { "$ref": "common.schema.json#/$defs/I18nString" },
    "description": {
      "$ref": "common.schema.json#/$defs/I18nString",
      "description": "一句话菜品简介（可选），菜单页抽屉展示；三语 I18nString"
    },
    "image": {
      "$ref": "common.schema.json#/$defs/ImageRef",
      "description": "成品图 { src, license, author?, sourceUrl? }"
    },
    "baseServings": {
      "type": "integer",
      "minimum": 1,
      "description": "配方基准份数，食堂尺度（如 50）；采购与备餐按 plannedServings/baseServings 缩放"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ingredientRef": { "$ref": "common.schema.json#/$defs/Id" },
          "qty": { "$ref": "common.schema.json#/$defs/Quantity" },
          "prep": {
            "type": "object",
            "description": "该配料在本菜中的备菜规格（备料单「能教」关卡的依据）",
            "properties": {
              "techniqueRef": {
                "$ref": "common.schema.json#/$defs/Id",
                "description": "刀工/预处理技法，必须是 data/techniques.json 中的 id（闭集）"
              },
              "size": {
                "type": "string",
                "minLength": 1,
                "description": "尺寸/规格补充，如 3mm、2cm 见方"
              },
              "timing": {
                "type": "string",
                "enum": ["day-before", "morning", "before-service"],
                "description": "备料时机（可选）：day-before=前一天 / morning=当天早上 / before-service=开餐前。备料单按它分组，缺省归「早上」（execution-brief §3 v0.1）"
              },
              "note": { "$ref": "common.schema.json#/$defs/I18nString" },
              "image": {
                "$ref": "common.schema.json#/$defs/ImageRef",
                "description": "该配料「被切的几秒」的截帧（视频导入时由 skill 产出）；{ src, license, author?, sourceUrl? }"
              }
            },
            "required": ["techniqueRef"],
            "additionalProperties": false
          },
          "confidence": {
            "$ref": "common.schema.json#/$defs/Confidence",
            "description": "视频导入等机器来源的用量置信度；人工录入可省略（视为 1.0/manual）"
          }
        },
        "required": ["ingredientRef", "qty"],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": { "$ref": "common.schema.json#/$defs/I18nString" },
          "techniqueRef": {
            "$ref": "common.schema.json#/$defs/Id",
            "description": "本步涉及的加热/处理技法，闭集引用 data/techniques.json"
          },
          "image": { "$ref": "common.schema.json#/$defs/ImageRef" },
          "clip": {
            "type": "object",
            "description": "对应视频片段（秒），便于备料/教学时回放",
            "properties": {
              "videoUrl": { "type": "string", "format": "uri" },
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "minimum": 0 }
            },
            "required": ["videoUrl", "start", "end"],
            "additionalProperties": false
          }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "description": "来源溯源；视频导入的菜必填 videoUrl。source=example 表示设计稿/演示用示例菜：构建（build-data）时排除，不得当真实数据发布（execution-brief §7）",
      "properties": {
        "source": { "type": "string", "enum": ["manual", "video", "example"] },
        "videoUrl": { "type": "string", "format": "uri" }
      },
      "required": ["source"],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"],
      "description": "缺省视为 draft；只有 active 的菜参与菜单与采购推导"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
