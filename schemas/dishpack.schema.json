{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/dishpack.schema.json",
  "title": "DishPack",
  "description": "视频导入标准包：云端/第三方解析 skill 与本地知识库之间的交换格式。主格式为 schema.org/Recipe JSON-LD（manifest.recipe），附加溯源、置信度与人工确认队列字段。规范见 docs/video-import.md 与 skills/video-recipe-ingest/SKILL.md。",
  "type": "object",
  "properties": {
    "packVersion": {
      "type": "string",
      "const": "1",
      "description": "标准包格式版本，独立于实体 schemaVersion"
    },
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "description": "解析引擎信息，保证管线可插拔（Gemini/Qwen/自托管同一输出契约）",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "engine": {
          "type": "string",
          "enum": ["gemini-flash", "gemini-pro", "qwen-vl", "self-hosted-pipeline", "manual"]
        },
        "engineVersion": { "type": "string" },
        "promptVersion": { "type": "string" }
      },
      "required": ["name", "engine"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "videoUrl": { "type": "string", "format": "uri" },
        "platform": {
          "type": "string",
          "enum": ["youtube", "bilibili", "douyin", "tiktok", "instagram", "local-file", "other"]
        },
        "detectedLang": {
          "type": "string",
          "enum": ["zh", "en", "uk", "other"],
          "description": "解析引擎检测到的旁白/字幕主语言"
        },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["videoUrl", "detectedLang"],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "object",
          "description": "schema.org/Recipe JSON-LD 原始输出（recipeIngredient 为纯字符串数组，由导入器映射到知识库 Ingredient）",
          "properties": {
            "@context": { "type": "string", "const": "https://schema.org" },
            "@type": { "type": "string", "const": "Recipe" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "recipeYield": { "type": "string" },
            "recipeIngredient": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "recipeInstructions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "@type": { "type": "string", "const": "HowToStep" },
                  "text": { "type": "string", "minLength": 1 },
                  "position": { "type": "integer", "minimum": 1 }
                },
                "required": ["@type", "text"],
                "additionalProperties": false
              }
            },
            "prepTime": {
              "type": "string",
              "pattern": "^PT(\\d+H)?(\\d+M)?(\\d+S)?$",
              "description": "ISO 8601 duration，如 PT10M"
            },
            "cookTime": {
              "type": "string",
              "pattern": "^PT(\\d+H)?(\\d+M)?(\\d+S)?$"
            },
            "recipeCuisine": { "type": "string" },
            "keywords": { "type": "string" },
            "tool": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": [
            "@context",
            "@type",
            "name",
            "recipeIngredient",
            "recipeInstructions"
          ],
          "additionalProperties": false
        },
        "ingredientMappings": {
          "type": "array",
          "description": "recipeIngredient 字符串 → 知识库 Ingredient 的映射结果，逐条带置信度；confidence.value < 0.85 必须进入人工确认队列",
          "items": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "recipeIngredient 中的原始字符串，如 \"鸡蛋 3 个\""
              },
              "ingredientRef": { "$ref": "common.schema.json#/$defs/Id" },
              "quantity": { "$ref": "common.schema.json#/$defs/Quantity" },
              "confidence": { "$ref": "common.schema.json#/$defs/Confidence" },
              "needsReview": {
                "type": "boolean",
                "description": "冗余标记：等于 confidence.value < 阈值，便于人工队列筛选"
              }
            },
            "required": ["raw", "confidence", "needsReview"],
            "additionalProperties": false
          }
        },
        "stepMapping": {
          "type": "array",
          "description": "与 dish.schema.json steps 对齐的结构化步骤（i18n 文本）",
          "items": {
            "type": "object",
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "instruction": { "$ref": "common.schema.json#/$defs/I18nString" },
              "durationMinutes": { "type": "number", "exclusiveMinimum": 0 },
              "tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "timestampRange": {
                "type": "object",
                "description": "对应视频时间段（秒），便于人工抽检回放",
                "properties": {
                  "startSec": { "type": "number", "minimum": 0 },
                  "endSec": { "type": "number", "minimum": 0 }
                },
                "required": ["startSec", "endSec"],
                "additionalProperties": false
              }
            },
            "required": ["order", "instruction"],
            "additionalProperties": false
          }
        },
        "suggestedDish": {
          "type": "object",
          "description": "导入器合成 Dish 实体时的建议字段（三语名称、分类、基准份数）",
          "properties": {
            "name": { "$ref": "common.schema.json#/$defs/I18nString" },
            "category": {
              "type": "string",
              "enum": [
                "staple",
                "meat-dish",
                "vegetable-dish",
                "soup",
                "cold-dish",
                "snack",
                "dessert",
                "drink"
              ]
            },
            "baseServings": { "type": "integer", "minimum": 1 }
          },
          "required": ["name", "category", "baseServings"],
          "additionalProperties": false
        },
        "overallConfidence": {
          "$ref": "common.schema.json#/$defs/Confidence"
        }
      },
      "required": ["recipe", "ingredientMappings", "overallConfidence"],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "description": "原文转写，保留以便溯源与人工校对",
      "properties": {
        "lang": { "type": "string", "enum": ["zh", "en", "uk", "other"] },
        "text": { "type": "string", "minLength": 1 },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": { "type": "number", "minimum": 0 },
              "endSec": { "type": "number", "minimum": 0 },
              "text": { "type": "string" }
            },
            "required": ["startSec", "endSec", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["lang", "text"],
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "description": "媒体引用（关键帧/封面），包内相对路径或外部 URL",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["keyframe", "cover", "clip"] },
          "ref": { "type": "string", "minLength": 1 },
          "timestampSec": { "type": "number", "minimum": 0 }
        },
        "required": ["kind", "ref"],
        "additionalProperties": false
      }
    },
    "reviewQueue": {
      "type": "object",
      "description": "人工确认队列状态",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "进入队列的原因，如 low-confidence-ingredient、unit-conversion-missing"
        }
      },
      "required": ["status"],
      "additionalProperties": false
    }
  },
  "required": [
    "packVersion",
    "id",
    "createdAt",
    "generator",
    "source",
    "manifest",
    "reviewQueue"
  ],
  "additionalProperties": false
}
