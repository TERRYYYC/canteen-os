{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/dish-v3.schema.json",
  "title": "DishV3",
  "description": "小团队菜谱：未知用量省略 qty，不能伪造 to-taste。旧 v2 保持严格，见 ADR-0008。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3"
    },
    "name": {
      "$ref": "dish.schema.json#/properties/name"
    },
    "description": {
      "$ref": "dish.schema.json#/properties/description"
    },
    "image": {
      "$ref": "dish.schema.json#/properties/image"
    },
    "baseServings": {
      "$ref": "dish.schema.json#/properties/baseServings"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ingredientRef": {
            "$ref": "dish.schema.json#/properties/components/items/properties/ingredientRef"
          },
          "qty": {
            "$ref": "dish.schema.json#/properties/components/items/properties/qty"
          },
          "prep": {
            "$ref": "dish.schema.json#/properties/components/items/properties/prep"
          },
          "confidence": {
            "$ref": "dish.schema.json#/properties/components/items/properties/confidence"
          },
          "originalAmount": { "type": "string", "description": "经审核来源的原方用量；即使不能换算也必须保留" },
          "originalText": { "type": "string", "description": "原方食材行文本" },
          "originalPreparation": { "$ref": "common.schema.json#/$defs/I18nString" },
          "knowledgeIngredientId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
        },
        "required": [
          "ingredientRef"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "$ref": "dish.schema.json#/properties/steps"
    },
    "provenance": { "oneOf": [
      { "$ref": "dish.schema.json#/properties/provenance" },
      { "type": "object", "properties": {
        "source": { "const": "knowledge" },
        "recipeId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "recipeVersion": { "type": "integer", "minimum": 1 },
        "candidateId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "snapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "review": { "type": "object", "properties": {
          "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
          "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "approvedCandidateVersion": { "type": "integer", "minimum": 1 }
        }, "required": ["reviewer", "note", "approvedCandidateVersion"], "additionalProperties": false },
        "sourceUrl": { "type": "string", "format": "uri" },
        "evidence": { "type": "object", "properties": {
          "sourceRecords": { "type": "array", "items": { "type": "object" } },
          "sourceRefs": { "type": "array", "items": { "type": "object" } },
          "media": { "type": "array", "items": { "type": "object" } },
          "unresolved": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
        }, "required": ["sourceRecords", "sourceRefs"], "additionalProperties": false }
      }, "required": ["source","recipeId","recipeVersion","candidateId","snapshotHash"], "additionalProperties": false }
    ] },
    "status": {
      "$ref": "dish.schema.json#/properties/status"
    }
  },
  "required": [
    "schemaVersion",
    "name"
  ],
  "additionalProperties": false
}
