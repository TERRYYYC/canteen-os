{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/dish-v3.schema.json",
  "title": "DishV3",
  "description": "小团队菜谱：未知用量省略 qty，不能伪造 to-taste。旧 v2 保持严格，见 ADR-0008。按 ADR-0012 记的菜份数写 1：份数为 1 的菜，每个有数的 qty 都要有 qtySource；原方的数只进 originalAmount / originalQty，不进计算；unknowns 的位置不能越界（后两条 JSON Schema 管不到，由 scripts/validate-schemas.mjs 检查）。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3"
    },
    "name": {
      "$ref": "dish.schema.json#/properties/name"
    },
    "description": {
      "$ref": "dish.schema.json#/properties/description"
    },
    "image": {
      "$ref": "dish.schema.json#/properties/image"
    },
    "baseServings": {
      "$ref": "dish.schema.json#/properties/baseServings"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ingredientRef": {
            "$ref": "dish.schema.json#/properties/components/items/properties/ingredientRef"
          },
          "qty": {
            "$ref": "dish.schema.json#/properties/components/items/properties/qty"
          },
          "qtySource": {
            "$ref": "common.schema.json#/$defs/ValueSource",
            "description": "qty 的出处：师傅实称、师傅指定，或按师傅规则（ADR-0012 第 3 条）。份数为 1 的菜，每个有数的 qty 都必须有它"
          },
          "prep": {
            "type": "object",
            "description": "该配料在本菜中的备菜规格（备料单「能教」关卡的依据）",
            "properties": {
              "techniqueRef": {
                "$ref": "common.schema.json#/$defs/Id",
                "description": "刀工/预处理技法，必须是 data/techniques.json 中的 id（闭集）"
              },
              "size": {
                "type": "string",
                "minLength": 1,
                "description": "尺寸/规格补充，如 3mm、2cm 见方"
              },
              "timing": {
                "type": "string",
                "enum": [
                  "day-before",
                  "morning",
                  "before-service"
                ],
                "description": "备料时机（可选）：day-before=前一天 / morning=当天早上 / before-service=开餐前。备料单按它分组，缺省归「早上」（execution-brief §3 v0.1）"
              },
              "leadTime": {
                "$ref": "#/$defs/LeadTime",
                "description": "要提前多久：腌、泡、卤、醒的时长（ADR-0012 第 8 条）。什么时候准备仍写 timing，note 不再记时长"
              },
              "note": {
                "$ref": "common.schema.json#/$defs/I18nString"
              },
              "image": {
                "$ref": "common.schema.json#/$defs/ImageRef",
                "description": "该配料「被切的几秒」的截帧（视频导入时由 skill 产出）；{ src, license, author?, sourceUrl? }"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "confidence": {
            "$ref": "dish.schema.json#/properties/components/items/properties/confidence"
          },
          "originalAmount": {
            "type": "string",
            "description": "经审核来源的原方用量；即使不能换算也必须保留"
          },
          "originalQty": {
            "$ref": "common.schema.json#/$defs/Quantity",
            "description": "原方里的数，结构化后只用来显示，不参与采购和备料计算（ADR-0012 第 1 条）；原话仍在 originalAmount"
          },
          "originalText": {
            "type": "string",
            "description": "仅兼容旧版已存资料；对外投影必须移除"
          },
          "originalPreparation": {
            "$ref": "common.schema.json#/$defs/I18nString"
          },
          "knowledgeIngredientId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "canonicalIngredientId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "canonicalIngredientVersion": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "main",
              "seasoning"
            ]
          }
        },
        "required": [
          "ingredientRef"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "canonicalIngredientId": [
            "canonicalIngredientVersion"
          ],
          "canonicalIngredientVersion": [
            "canonicalIngredientId"
          ],
          "qtySource": [
            "qty"
          ],
          "originalQty": [
            "originalAmount"
          ]
        }
      }
    },
    "steps": {
      "$ref": "dish.schema.json#/properties/steps"
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "description": "视频里没说清的地方：只记类别和位置，不记原话（原话留在私有知识库，ADR-0010）。没有就省略本字段，不写空数组（ADR-0012 第 11 条）",
      "items": {
        "$ref": "#/$defs/RecipeUnknown"
      }
    },
    "provenance": {
      "oneOf": [
        {
          "$ref": "dish.schema.json#/properties/provenance"
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "knowledge"
            },
            "recipeId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "recipeVersion": {
              "type": "integer",
              "minimum": 1
            },
            "candidateId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "snapshotHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "review": {
              "type": "object",
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "approvedCandidateVersion": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "reviewer",
                "note",
                "approvedCandidateVersion"
              ],
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "evidence": {
              "type": "object",
              "properties": {
                "sourceRecords": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "media": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "unresolved": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              },
              "required": [
                "sourceRecords",
                "sourceRefs"
              ],
              "additionalProperties": false
            },
            "sourceGapCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "旧字段，ADR-0011 后不再写入；只留给旧资料读取，不换算成 unknowns"
            },
            "coverState": {
              "type": "string",
              "enum": [
                "needs-image",
                "rights-pending",
                "external-unpinned",
                "unavailable"
              ],
              "description": "可公开的缺图原因；私有来源图片及网址不进入发布资料"
            },
            "approvalHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "originKind": {
              "enum": [
                "favorite",
                "manual",
                "legacy"
              ]
            },
            "originalRecipeVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "source",
            "recipeId",
            "recipeVersion",
            "snapshotHash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "status": {
      "$ref": "dish.schema.json#/properties/status"
    }
  },
  "required": [
    "schemaVersion",
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "LeadTime": {
      "type": "object",
      "description": "提前时长：数值加单位。min=分钟，h=小时，d=天",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "min",
            "h",
            "d"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "RecipeUnknown": {
      "type": "object",
      "description": "一处没说清：类别加位置。stepIndex、componentIndex 都不带，就是整道菜的；位置从 0 起，不能越界（由 scripts/validate-schemas.mjs 检查）",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "prep-ahead",
            "amount",
            "net-or-gross",
            "cut-size",
            "identity",
            "heat",
            "duration",
            "doneness",
            "other"
          ],
          "description": "prep-ahead=提前多久，amount=用量，net-or-gross=毛重还是净重，cut-size=切多大，identity=用哪种，heat=火候，duration=做多久，doneness=做到什么样，other=别的"
        },
        "action": {
          "type": "string",
          "enum": [
            "marinate",
            "soak",
            "brine",
            "rest",
            "cool",
            "other"
          ],
          "description": "只用于 prep-ahead：要提前做的是腌、泡、卤、醒、晾凉，还是别的"
        },
        "stepIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "在 steps 里的位置，从 0 起"
        },
        "componentIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "在 components 里的位置，从 0 起"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "prep-ahead"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "action"
            ]
          }
        },
        {
          "if": {
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "prep-ahead"
              }
            }
          }
        }
      ]
    }
  }
}
