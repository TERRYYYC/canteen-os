{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/menu-plan.schema.json",
  "title": "MenuPlan",
  "description": "菜单计划：日期×餐次×菜品×计划份数，是采购引擎的输入。plannedServings 可由预定点餐数据驱动（见 docs/modules/feedback.md）。",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "schemaVersion": { "type": "string", "const": "1" },
    "name": { "$ref": "common.schema.json#/$defs/I18nString" },
    "dateRange": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "meals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "mealType": { "$ref": "common.schema.json#/$defs/MealType" },
          "dishRef": { "$ref": "common.schema.json#/$defs/Id" },
          "plannedServings": { "type": "integer", "minimum": 1 }
        },
        "required": ["date", "mealType", "dishRef", "plannedServings"],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "locked"]
    }
  },
  "required": ["id", "schemaVersion", "dateRange", "meals", "status"],
  "additionalProperties": false
}
