{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/menu-plan.schema.json",
  "title": "MenuPlan",
  "description": "菜单计划（v2 收窄模型，ADR-0006）：日期 × 餐次 × 菜品 × 份数，外加 margin 备量系数。一计划一文件：data/menu-plans/<id>.json，文件名即 ID。menu-plan 是采购引擎的输入；无状态机字段（排定即事实，修改直接改文件走 PR）。",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "2" },
    "name": { "$ref": "common.schema.json#/$defs/I18nString" },
    "dateRange": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "margin": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "备量系数，默认 1.1：吸收不随份数线性放大的固定尾料/挂壁损耗（ADR-0006）。作用于净需求聚合之后（净需求 ÷ yield × margin），仅对按重量/体积（g/ml）计的食材生效，pcs 计数食材不乘"
    },
    "meals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "mealType": { "$ref": "common.schema.json#/$defs/MealType" },
          "dishRef": {
            "$ref": "common.schema.json#/$defs/Id",
            "description": "data/dishes/ 下的菜品 id（文件名）"
          },
          "plannedServings": { "type": "integer", "minimum": 1 },
          "serviceWindow": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}-\\d{2}:\\d{2}$",
            "description": "供餐时段（可选），HH:MM-HH:MM，如 12:00-14:00；菜单页餐次 chip 展示"
          }
        },
        "required": ["date", "mealType", "dishRef", "plannedServings"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "meals"],
  "additionalProperties": false
}
