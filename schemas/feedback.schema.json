{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/feedback.schema.json",
  "title": "Feedback",
  "description": "点餐订单 / 评分 / 评论。预定点餐（mealOrder）驱动 MenuPlan.plannedServings；评分与评论反哺菜单计划与运营报告。",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "schemaVersion": { "type": "string", "const": "1" },
    "type": {
      "type": "string",
      "enum": ["mealOrder", "rating", "comment"],
      "description": "mealOrder=预定点餐；rating=评分；comment=评论"
    },
    "dishRef": { "$ref": "common.schema.json#/$defs/Id" },
    "date": { "type": "string", "format": "date" },
    "mealType": { "$ref": "common.schema.json#/$defs/MealType" },
    "customerRef": {
      "type": "string",
      "minLength": 1,
      "description": "匿名化的顾客标识，不存个人敏感信息"
    },
    "servings": {
      "type": "integer",
      "minimum": 1,
      "description": "仅 mealOrder：预定份数"
    },
    "orderStatus": {
      "type": "string",
      "enum": ["reserved", "redeemed", "cancelled", "no-show"],
      "description": "仅 mealOrder：reserved=已预定；redeemed=已核销取餐；no-show=未取餐"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "仅 rating：1-5 星"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "too-salty",
          "too-bland",
          "too-spicy",
          "too-greasy",
          "portion-small",
          "portion-large",
          "temperature-cold",
          "fresh",
          "would-reorder"
        ]
      },
      "uniqueItems": true,
      "description": "结构化反馈标签（受控词表，可随版本扩充）"
    },
    "comment": {
      "type": "object",
      "description": "仅 comment：原文 + 三语翻译。原文必填，翻译可后补（见 docs/i18n.md）",
      "properties": {
        "originalLang": { "type": "string", "enum": ["zh", "en", "uk"] },
        "original": { "type": "string", "minLength": 1 },
        "translations": { "$ref": "common.schema.json#/$defs/I18nString" }
      },
      "required": ["originalLang", "original"],
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "id",
    "schemaVersion",
    "type",
    "dishRef",
    "date",
    "customerRef",
    "createdAt"
  ],
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "mealOrder" } } },
      "then": { "required": ["mealType", "servings", "orderStatus"] }
    },
    {
      "if": { "properties": { "type": { "const": "rating" } } },
      "then": { "required": ["rating"] }
    },
    {
      "if": { "properties": { "type": { "const": "comment" } } },
      "then": { "required": ["comment"] }
    }
  ],
  "additionalProperties": false
}
