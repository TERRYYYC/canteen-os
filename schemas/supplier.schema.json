{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/supplier.schema.json",
  "title": "Supplier",
  "description": "供应商及其 SKU。SKU 把食材（ingredientRef）与包装规格、价格、MOQ、提前期绑定，是采购引擎向上取整与拆单的依据。",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "schemaVersion": { "type": "string", "const": "1" },
    "name": { "$ref": "common.schema.json#/$defs/I18nString" },
    "contact": {
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "additionalProperties": false
    },
    "skus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "skuId": { "type": "string", "minLength": 1 },
          "ingredientRef": { "$ref": "common.schema.json#/$defs/Id" },
          "packageSize": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "单包装内的净含量（packageUnit 计）"
          },
          "packageUnit": { "$ref": "common.schema.json#/$defs/Unit" },
          "price": {
            "$ref": "common.schema.json#/$defs/Money",
            "description": "单包装价格"
          },
          "moq": {
            "type": "integer",
            "minimum": 1,
            "description": "最小起订量，以包装数计"
          },
          "leadTimeDays": {
            "type": "integer",
            "minimum": 0,
            "description": "下单到收货的自然日数"
          },
          "isPreferred": {
            "type": "boolean",
            "description": "同一 ingredientRef 多个 SKU 时标记首选供应商"
          }
        },
        "required": [
          "skuId",
          "ingredientRef",
          "packageSize",
          "packageUnit",
          "price",
          "leadTimeDays"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "schemaVersion", "name", "skus"],
  "additionalProperties": false
}
