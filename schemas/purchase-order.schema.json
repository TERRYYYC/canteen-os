{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canteenos.dev/schemas/purchase-order.schema.json",
  "title": "PurchaseOrder",
  "description": "采购单（v2 收窄模型，ADR-0006）：**引擎输出的快照，无状态机**——确认/下单/收货发生在线下（微信/电话），不进数据模型。一单一文件：data/purchase-orders/<id>.json。每个食材一行，按 ingredient.purchase.supplier 字符串分组出单；**每行必须带 trace**（完整推导链：哪个菜、多少份、净需求、÷yield、×margin、扣 onHand、÷packSize 向上取整、minPacks），保证「为什么买这个数」永远可解释。数字基准见 docs/modules/procurement.md §2。",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "2" },
    "supplier": {
      "type": "string",
      "minLength": 1,
      "description": "供应商名字符串（分组键）；无 purchase 信息的食材由引擎归入「未指定供应商」单"
    },
    "menuPlanRef": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "来源菜单计划（data/menu-plans/ 文件名 id）"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ingredientRef": { "$ref": "common.schema.json#/$defs/Id" },
          "qty": {
            "$ref": "common.schema.json#/$defs/Quantity",
            "description": "实际采购总量 = packs × packSize（packUnit 计）"
          },
          "packs": {
            "type": "integer",
            "minimum": 1,
            "description": "max(minPacks, ceil(扣减后需求 ÷ packSize))"
          },
          "unitPrice": {
            "$ref": "common.schema.json#/$defs/Money",
            "description": "下单时 ingredient.purchase.lastPrice 快照（可能未知而缺省）"
          },
          "amount": {
            "$ref": "common.schema.json#/$defs/Money",
            "description": "行金额 = packs × unitPrice（unitPrice 缺省时缺省）"
          },
          "trace": {
            "type": "object",
            "description": "推导链快照：全部为引擎计算当时的数值，事后不随 ingredient 数据变更而变",
            "properties": {
              "meals": {
                "type": "array",
                "minItems": 1,
                "description": "该食材需求来自哪些餐次（哪个菜、多少份）",
                "items": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string", "format": "date" },
                    "mealType": { "$ref": "common.schema.json#/$defs/MealType" },
                    "dishRef": { "$ref": "common.schema.json#/$defs/Id" },
                    "servings": { "type": "integer", "minimum": 1 }
                  },
                  "required": ["date", "mealType", "dishRef", "servings"],
                  "additionalProperties": false
                }
              },
              "netNeed": {
                "$ref": "common.schema.json#/$defs/Quantity",
                "description": "Σ plannedServings/baseServings × qty 聚合后的净需求（baseUnit 计）"
              },
              "yieldApplied": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0,
                "maximum": 1,
                "description": "÷ 的净料率；pcs 食材或食材无 yield 时为 null"
              },
              "marginApplied": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0,
                "description": "× 的备量系数（menu-plan.margin）；所有食材均为实际所乘值（margin 对 pcs 同样生效，ADR-0006 2026-09-06 修正）"
              },
              "onHandDeducted": {
                "anyOf": [
                  { "$ref": "common.schema.json#/$defs/Quantity" },
                  { "type": "null" }
                ],
                "description": "扣减的现有量（baseUnit 计）；trackStock=false 或无 onHand 时为 null"
              },
              "grossNeed": {
                "$ref": "common.schema.json#/$defs/Quantity",
                "description": "净需求 ÷ yield × margin − onHand 之后、取整之前的采购需求（baseUnit 计）"
              },
              "packSize": { "type": "number", "exclusiveMinimum": 0 },
              "packUnit": { "$ref": "common.schema.json#/$defs/Unit" },
              "packsRaw": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "grossNeed ÷ packSize 的未取整值（g↔kg、ml↔l 代码常量换算后）"
              },
              "minPacksApplied": {
                "type": "boolean",
                "description": "ceil(packsRaw) 是否被 minPacks 抬高"
              }
            },
            "required": [
              "meals",
              "netNeed",
              "yieldApplied",
              "marginApplied",
              "onHandDeducted",
              "grossNeed",
              "packSize",
              "packUnit",
              "packsRaw",
              "minPacksApplied"
            ],
            "additionalProperties": false
          }
        },
        "required": ["ingredientRef", "qty", "packs", "trace"],
        "additionalProperties": false
      }
    },
    "totalAmount": { "$ref": "common.schema.json#/$defs/Money" },
    "notes": { "type": "string" }
  },
  "required": ["schemaVersion", "supplier", "generatedAt", "lines"],
  "additionalProperties": false
}
